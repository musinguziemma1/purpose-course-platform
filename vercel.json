{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "regions": ["fra1"],
  "schedules": {
    "email-delivery": {
      "schedule": "*/15 * * * *",
      "path": "/api/jobs/email",
      "requestMethod": "GET"
    },
    "scheduled-publishing": {
      "schedule": "*/15 * * * *",
      "path": "/api/jobs/publishing",
      "requestMethod": "GET"
    },
    "platform-maintenance": {
      "schedule": "*/15 * * * *",
      "path": "/api/jobs/maintenance",
      "requestMethod": "GET"
    }
  }
}
