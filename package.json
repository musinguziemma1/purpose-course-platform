{
  "name": "purpose-course-platform",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "predev": "node scripts/local-db.mjs start",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "prestart": "node scripts/local-db.mjs start",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:check:supabase": "node scripts/supabase-db.mjs check",
    "db:verify:supabase": "node scripts/supabase-db.mjs verify",
    "test:database": "node --test scripts/database-config.test.mjs",
    "test:security": "node --import tsx --test tests/*.test.mjs",
    "admin:manage": "node scripts/manage-admin.mjs",
    "test:passwords": "node --test scripts/password-security.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.71.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
