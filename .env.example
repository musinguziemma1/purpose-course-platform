# Project-local PostgreSQL, managed by npm run db:start.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/purpose_course_local

# Demo access requires this flag, a local database, and development mode.
PURPOSE_DEMO_OPEN=true
NEXT_TELEMETRY_DISABLED=1

# Supabase runtime settings belong in ignored .env.local (overrides .env).
# Use a restricted backend role, never the postgres administrator as runtime.
# DATABASE_URL=postgresql://purpose_app.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_POOL_MAX=5
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# PURPOSE_DEMO_OPEN=false
